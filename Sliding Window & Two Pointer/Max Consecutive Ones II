int findMaxOnes(vector<int>& arr) {
        int n=arr.size();
        int i=0,j=0,ans=0,zeroes=0;
        while(j<n){
            if(arr[j]==0) zeroes++;
            while(zeroes>1){
                if(arr[i]==0) zeroes--;
                i++;
            }
            ans=max(ans,j-i+1);
            j++;
        }
        return ans;
    }
